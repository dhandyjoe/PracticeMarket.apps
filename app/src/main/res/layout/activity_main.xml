<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pm_surface"
    android:orientation="vertical">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/shop_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/pm_background" />

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/pm_stroke_hairline"
        android:background="@color/pm_outline" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/shop_nav_bottom"
        style="@style/Widget.PracticeMart.BottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:menu="@menu/menu_bottom_nav" />
</LinearLayout>
