<?xml version="1.0" encoding="utf-8"?>
<!-- Top app bar standar (DESIGN.md §4.1): back 48 dp, judul rata kiri, garis bawah. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/pm_surface"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="@dimen/pm_header_height"
        android:orientation="horizontal"
        android:paddingEnd="@dimen/pm_space_2"
        android:paddingStart="@dimen/pm_space_1">

        <ImageButton
            android:id="@+id/shop_btn_back"
            style="@style/Pm.IconButton"
            android:contentDescription="@string/nav_back"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/pm_ink" />

        <TextView
            android:id="@+id/shop_txt_title"
            style="@style/Pm.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/pm_space_2"
            android:layout_weight="1"
            android:accessibilityHeading="true"
            android:textSize="18sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/pm_stroke_hairline"
        android:background="@color/pm_outline" />
</LinearLayout>
