<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/pm_space_4">

    <ImageView
        android:id="@+id/acc_img_menu"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:importantForAccessibility="no"
        app:tint="@color/pm_ink_secondary" />

    <TextView
        android:id="@+id/acc_txt_menu"
        style="@style/Pm.Body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/pm_space_3"
        android:layout_weight="1"
        android:textColor="@color/pm_ink" />

    <TextView
        android:id="@+id/acc_txt_menu_tag"
        style="@style/Pm.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/pm_space_2"
        android:textSize="12sp"
        android:visibility="gone" />

    <ImageView
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_chevron_right"
        app:tint="@color/pm_ink_muted" />
</LinearLayout>
