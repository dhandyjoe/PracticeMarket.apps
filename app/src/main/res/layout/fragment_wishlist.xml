<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pm_background"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/shop_header_wishlist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/pm_surface"
        android:gravity="center_vertical"
        android:minHeight="@dimen/pm_header_height"
        android:orientation="horizontal"
        android:paddingEnd="@dimen/pm_space_2"
        android:paddingStart="@dimen/pm_space_1">

        <ImageButton
            android:id="@+id/shop_btn_back"
            style="@style/Pm.IconButton"
            android:contentDescription="@string/nav_back"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/pm_ink" />

        <TextView
            style="@style/Pm.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/pm_space_2"
            android:layout_weight="1"
            android:text="@string/wishlist_title" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/shop_btn_edit_order"
            style="@style/Widget.PracticeMart.Button.Text"
            android:layout_width="wrap_content" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/pm_stroke_hairline"
        android:background="@color/pm_outline" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/shop_list_wishlist"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="@dimen/pm_space_4" />

        <LinearLayout
            android:id="@+id/shop_empty_wishlist"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/pm_space_8"
            android:visibility="gone">

            <TextView
                style="@style/Pm.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/wishlist_empty_title" />

            <TextView
                style="@style/Pm.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/pm_space_2"
                android:gravity="center"
                android:text="@string/wishlist_empty_body" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/shop_btn_start_shopping"
                style="@style/Widget.PracticeMart.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_marginTop="@dimen/pm_space_6"
                android:paddingHorizontal="@dimen/pm_space_8"
                android:text="@string/wishlist_start_shopping" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
