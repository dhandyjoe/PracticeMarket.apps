<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/shop_item_product_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="@dimen/pm_space_1"
    app:cardBackgroundColor="@color/pm_surface"
    app:cardCornerRadius="@dimen/pm_radius_card"
    app:cardElevation="0dp"
    app:strokeColor="@color/pm_outline"
    app:strokeWidth="@dimen/pm_stroke_hairline">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/pm_space_2_5">

        <LinearLayout
            android:id="@+id/shop_item_product_open"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/shop_img_product_bg"
                android:layout_width="@dimen/pm_product_thumb"
                android:layout_height="@dimen/pm_product_thumb">

                <ImageView
                    android:id="@+id/shop_img_product"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/pm_space_3"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/shop_txt_product_name"
                    style="@style/Pm.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/pm_ink"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/shop_txt_product_price"
                    style="@style/Pm.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/pm_ink"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/shop_txt_product_rating"
                    style="@style/Pm.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/shop_btn_add_to_cart"
            style="@style/Widget.PracticeMart.Button.OutlinePrimary"
            android:layout_width="@dimen/pm_icon_button"
            android:layout_height="@dimen/pm_icon_button"
            android:layout_marginStart="@dimen/pm_space_3"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:minWidth="0dp"
            android:padding="0dp"
            app:icon="@drawable/ic_add"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="20dp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
