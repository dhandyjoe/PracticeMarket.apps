<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pm_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/shop_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/pm_background" />

        <!-- Data akun terakhir dibaca dari cache lokal (Firestore tidak terjangkau); ketuk = muat ulang. -->
        <TextView
            android:id="@+id/shop_banner_stale"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:background="@drawable/bg_banner_error"
            android:padding="@dimen/pm_space_3_5"
            android:text="@string/stale_banner"
            android:textColor="@color/pm_error_strong"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/pm_stroke_hairline"
            android:background="@color/pm_outline" />

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/shop_nav_bottom"
            style="@style/Widget.PracticeMart.BottomNav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:menu="@menu/menu_bottom_nav" />
    </LinearLayout>

    <!-- Muat data akun dari Firestore saat app dibuka (contract §6 "Data akun gagal dimuat"). -->
    <LinearLayout
        android:id="@+id/shop_panel_load"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/pm_surface"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/pm_space_4"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/shop_progress_load"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:indeterminateTint="@color/pm_primary" />

        <TextView
            android:id="@+id/shop_txt_load_error"
            style="@style/Pm.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:text="@string/load_failed"
            android:textColor="@color/pm_ink"
            android:textSize="15sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/shop_btn_load_retry"
            style="@style/Widget.PracticeMart.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/pm_space_4"
            android:text="@string/retry" />
    </LinearLayout>
</FrameLayout>
