<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pm_surface"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/shop_content_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/pm_space_6">

            <ImageView
                android:id="@+id/shop_img_result"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_marginTop="@dimen/pm_space_8"
                android:importantForAccessibility="no"
                android:padding="@dimen/pm_space_6" />

            <TextView
                android:id="@+id/shop_txt_result_title"
                style="@style/Pm.Headline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/pm_space_5"
                android:accessibilityLiveRegion="polite"
                android:gravity="center"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/shop_txt_result_body"
                style="@style/Pm.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/pm_space_2"
                android:gravity="center" />

            <LinearLayout
                android:id="@+id/shop_card_result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/pm_space_6"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="@dimen/pm_space_4">

                <LinearLayout
                    android:id="@+id/shop_row_result_order"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Pm.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/result_order_id"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/shop_txt_order_id"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/pm_space_3"
                        android:layout_weight="1"
                        android:fontFamily="@font/jetbrains_mono"
                        android:gravity="end"
                        android:textColor="@color/pm_ink"
                        android:textIsSelectable="true"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/shop_btn_copy_order"
                        style="@style/Pm.IconButton"
                        android:contentDescription="@string/result_copy_order_cd"
                        android:src="@drawable/ic_copy"
                        app:tint="@color/pm_ink" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/pm_space_2"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Pm.Body"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/result_total"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/shop_txt_result_total"
                        style="@style/Pm.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/pm_ink"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/pm_space_2"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Pm.Body"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/result_method"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/shop_txt_result_method"
                        style="@style/Pm.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/pm_ink"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/shop_row_result_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/pm_space_2"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Pm.Body"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/result_status"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/shop_txt_result_status"
                        style="@style/Pm.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/shop_bar_result"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/pm_space_4">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/shop_btn_result_primary"
            style="@style/Widget.PracticeMart.Button.Primary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/shop_btn_result_home"
            style="@style/Widget.PracticeMart.Button.Text"
            android:layout_width="match_parent"
            android:text="@string/result_back_home" />
    </LinearLayout>
</LinearLayout>
