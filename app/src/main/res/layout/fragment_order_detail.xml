<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pm_background"
    android:orientation="vertical">

    <include
        android:id="@+id/shop_topbar"
        layout="@layout/layout_topbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/pm_space_4">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_dark_card"
                android:orientation="vertical"
                android:padding="@dimen/pm_space_4">

                <TextView
                    style="@style/Pm.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.05"
                    android:text="@string/ord_id_label"
                    android:textColor="@color/pm_ink_disabled"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/pm_space_2_5"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/shop_txt_detail_order_id"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/jetbrains_mono"
                        android:textColor="@color/pm_dark_accent"
                        android:textIsSelectable="true"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/shop_btn_copy_order_id"
                        style="@style/Pm.IconButton"
                        android:contentDescription="@string/ord_copy_id"
                        android:src="@drawable/ic_copy"
                        app:tint="@color/pm_dark_accent" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/pm_space_2_5"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/shop_txt_detail_method"
                        style="@style/Pm.Caption"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/pm_dark_muted"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/shop_txt_detail_total"
                        style="@style/Pm.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/pm_white" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/pm_space_3"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="@dimen/pm_space_4">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/pm_space_3"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/shop_txt_detail_heading"
                        style="@style/Pm.Label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:letterSpacing="0.05"
                        android:text="@string/ord_status_heading"
                        android:textColor="@color/pm_ink_muted"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/shop_txt_detail_interval"
                        style="@style/Pm.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/jetbrains_mono"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/shop_list_timeline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/shop_txt_detail_cancelled"
                    style="@style/Pm.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ord_cancelled_body"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/shop_btn_next_status"
                    style="@style/Widget.PracticeMart.Button.Outline"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/pm_touch_min"
                    android:layout_marginTop="@dimen/pm_space_1"
                    android:text="@string/ord_next_status"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/shop_bar_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/pm_surface"
        android:orientation="vertical"
        android:paddingBottom="@dimen/pm_space_5"
        android:paddingHorizontal="@dimen/pm_space_4"
        android:paddingTop="@dimen/pm_space_3">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/shop_btn_cancel_order"
            style="@style/Widget.PracticeMart.Button.Outline"
            android:text="@string/ord_cancel_order"
            android:textColor="@color/pm_error"
            app:strokeColor="@color/pm_error" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/shop_btn_review"
            style="@style/Widget.PracticeMart.Button.Primary"
            android:text="@string/ord_review"
            android:visibility="gone" />

        <TextView
            android:id="@+id/shop_txt_cannot_cancel"
            style="@style/Pm.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/ord_cannot_cancel"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
