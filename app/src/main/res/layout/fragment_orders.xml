<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pm_background"
    android:orientation="vertical">

    <include
        android:id="@+id/shop_topbar"
        layout="@layout/layout_topbar" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/shop_tab_orders"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/pm_surface"
        app:tabGravity="start"
        app:tabIndicatorColor="@color/pm_primary"
        app:tabIndicatorHeight="3dp"
        app:tabMode="scrollable"
        app:tabRippleColor="@color/pm_primary_container"
        app:tabSelectedTextColor="@color/pm_primary"
        app:tabTextAppearance="@style/TextAppearance.PracticeMart.Chip"
        app:tabTextColor="@color/pm_ink_muted" />

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/pm_stroke_hairline"
        android:background="@color/pm_outline" />

    <TextView
        android:id="@+id/shop_txt_orders_updated"
        style="@style/Pm.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="@dimen/pm_space_2_5" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/shop_refresh_orders"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/shop_pager_orders"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>
