<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/shop_btn_see_all"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/pm_space_0_5"
    android:background="@drawable/bg_see_all"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center"
    android:minHeight="220dp"
    android:orientation="vertical">

    <TextView
        style="@style/Pm.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/home_see_all"
        android:textColor="@color/pm_primary_pressed"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/shop_txt_see_all_meta"
        style="@style/Pm.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/pm_space_2"
        android:textColor="@color/pm_ink_secondary" />
</LinearLayout>
