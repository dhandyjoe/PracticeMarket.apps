<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/pm_space_2"
    android:background="@drawable/bg_card"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/shop_btn_va_guide"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="@dimen/pm_touch_min"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/pm_space_3_5">

        <TextView
            android:id="@+id/shop_txt_va_guide_title"
            style="@style/Pm.Label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/pm_ink"
            android:textSize="15sp" />

        <ImageView
            android:id="@+id/shop_img_va_guide_chevron"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_expand"
            app:tint="@color/pm_ink_muted" />
    </LinearLayout>

    <TextView
        android:id="@+id/shop_txt_va_guide_steps"
        style="@style/Pm.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingMultiplier="1.2"
        android:paddingBottom="@dimen/pm_space_3_5"
        android:paddingHorizontal="@dimen/pm_space_3_5"
        android:textSize="14sp"
        android:visibility="gone" />
</LinearLayout>
