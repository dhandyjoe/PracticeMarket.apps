<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pm_surface"
    android:orientation="vertical">

    <ImageButton
        android:id="@+id/shop_btn_back"
        android:layout_width="@dimen/pm_touch_min"
        android:layout_height="@dimen/pm_touch_min"
        android:layout_margin="@dimen/pm_space_2"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/nav_back"
        android:src="@drawable/ic_arrow_back"
        app:tint="@color/pm_ink" />

    <!-- Form -->
    <LinearLayout
        android:id="@+id/newpw_form"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/pm_space_6"
                android:paddingTop="@dimen/pm_space_2">

                <TextView
                    style="@style/Pm.Headline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/newpw_title" />

                <TextView
                    style="@style/Pm.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/pm_space_2"
                    android:text="@string/newpw_subtitle" />

                <TextView
                    style="@style/Pm.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/pm_space_5"
                    android:labelFor="@+id/shop_input_new_password"
                    android:text="@string/newpw_label" />

                <EditText
                    android:id="@+id/shop_input_new_password"
                    style="@style/Pm.Field"
                    android:autofillHints="newPassword"
                    android:imeOptions="actionNext"
                    android:inputType="textPassword" />

                <TextView
                    style="@style/Pm.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/pm_space_4_5"
                    android:labelFor="@+id/shop_input_new_password_confirm"
                    android:text="@string/newpw_confirm_label" />

                <EditText
                    android:id="@+id/shop_input_new_password_confirm"
                    style="@style/Pm.Field"
                    android:autofillHints="newPassword"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/pm_space_2"
                    android:contentDescription="@string/newpw_rules"
                    android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/pm_space_2"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/shop_txt_rule_min_icon"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_remove" />

                    <TextView
                        android:id="@+id/shop_txt_rule_min"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/pm_space_2"
                        android:text="@string/rule_min"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/pm_space_2"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/shop_txt_rule_letter_icon"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_remove" />

                    <TextView
                        android:id="@+id/shop_txt_rule_letter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/pm_space_2"
                        android:text="@string/rule_letter"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/pm_space_2"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/shop_txt_rule_digit_icon"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_remove" />

                    <TextView
                        android:id="@+id/shop_txt_rule_digit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/pm_space_2"
                        android:text="@string/rule_digit"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/pm_space_2"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/shop_txt_rule_match_icon"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_remove" />

                    <TextView
                        android:id="@+id/shop_txt_rule_match"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/pm_space_2"
                        android:text="@string/rule_match"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <Button
            android:id="@+id/shop_btn_save_password"
            style="@style/Widget.PracticeMart.Button.Primary"
            android:layout_marginBottom="@dimen/pm_space_4"
            android:layout_marginHorizontal="@dimen/pm_space_6"
            android:layout_marginTop="@dimen/pm_space_3"
            android:enabled="false"
            android:text="@string/newpw_save" />
    </LinearLayout>

    <!-- Sukses -->
    <LinearLayout
        android:id="@+id/newpw_done"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/pm_space_6"
        android:visibility="gone">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_logo"
            android:backgroundTint="@color/pm_primary_container"
            android:importantForAccessibility="no"
            android:padding="19dp"
            android:src="@drawable/ic_check"
            app:tint="@color/pm_primary" />

        <TextView
            android:id="@+id/shop_txt_password_changed"
            style="@style/Pm.Headline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/pm_space_4"
            android:gravity="center"
            android:text="@string/newpw_done_title"
            android:textSize="24sp" />

        <TextView
            style="@style/Pm.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/pm_space_4"
            android:gravity="center"
            android:text="@string/newpw_done_body" />

        <Button
            android:id="@+id/shop_btn_goto_login"
            style="@style/Widget.PracticeMart.Button.Primary"
            android:layout_marginTop="@dimen/pm_space_4"
            android:text="@string/newpw_goto_login" />
    </LinearLayout>
</LinearLayout>
