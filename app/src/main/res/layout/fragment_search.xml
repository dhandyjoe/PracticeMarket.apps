<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pm_surface"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/shop_header_search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="@dimen/pm_space_2_5"
        android:paddingEnd="@dimen/pm_space_3"
        android:paddingStart="@dimen/pm_space_1"
        android:paddingTop="@dimen/pm_space_2_5">

        <ImageButton
            android:id="@+id/shop_btn_back"
            style="@style/Pm.IconButton"
            android:contentDescription="@string/nav_back"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/pm_ink" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="@dimen/pm_search_height"
            android:layout_marginStart="@dimen/pm_space_1_5"
            android:layout_weight="1"
            android:background="@drawable/bg_search_active"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/pm_space_3_5">

            <EditText
                android:id="@+id/shop_input_search"
                style="@style/Pm.Body"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/search_hint"
                android:imeOptions="actionSearch|flagNoExtractUi"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="@color/pm_ink"
                android:textColorHint="@color/pm_ink_muted" />

            <ImageButton
                android:id="@+id/shop_btn_clear_search"
                android:layout_width="@dimen/pm_icon_button"
                android:layout_height="@dimen/pm_icon_button"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/search_clear_text"
                android:src="@drawable/ic_clear"
                android:visibility="gone"
                app:tint="@color/pm_ink_muted" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/pm_stroke_hairline"
        android:background="@color/pm_outline" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/shop_scroll_search"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/shop_list_suggestions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/search_suggestions"
                android:orientation="vertical"
                android:paddingVertical="@dimen/pm_space_1"
                android:visibility="gone" />

            <TextView
                android:id="@+id/shop_txt_no_suggestion"
                style="@style/Pm.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/pm_space_5"
                android:textColor="@color/pm_ink_muted"
                android:textSize="14sp"
                android:visibility="gone" />

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/pm_space_2"
                android:background="@color/pm_background" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/pm_space_5"
                android:paddingTop="@dimen/pm_space_4">

                <TextView
                    style="@style/Pm.Label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/search_history"
                    android:textColor="@color/pm_ink"
                    android:textSize="15sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/shop_btn_clear_history"
                    style="@style/Widget.PracticeMart.Button.Text"
                    android:layout_width="wrap_content"
                    android:text="@string/search_history_clear_all" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/shop_list_history"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/shop_txt_history_empty"
                style="@style/Pm.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/pm_space_5"
                android:paddingVertical="@dimen/pm_space_2"
                android:text="@string/search_history_empty"
                android:textColor="@color/pm_ink_muted"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                style="@style/Pm.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/pm_space_5"
                android:paddingTop="@dimen/pm_space_5"
                android:text="@string/search_popular"
                android:textColor="@color/pm_ink"
                android:textSize="15sp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/shop_group_popular"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/pm_space_5"
                android:paddingVertical="@dimen/pm_space_3"
                app:chipSpacingHorizontal="@dimen/pm_space_2"
                app:chipSpacingVertical="@dimen/pm_space_2" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
