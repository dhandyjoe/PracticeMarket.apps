<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/shop_item_voucher_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/pm_space_2_5"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/pm_space_3_5">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/shop_txt_voucher_code"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/jetbrains_mono"
            android:textColor="@color/pm_option_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/shop_txt_voucher_row_title"
            style="@style/Pm.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/pm_space_1"
            android:textColor="@color/pm_option_text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/shop_txt_voucher_row_note"
            style="@style/Pm.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/pm_space_1" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/shop_btn_voucher_apply"
        style="@style/Widget.PracticeMart.Button.Primary"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginStart="@dimen/pm_space_3"
        android:textSize="13sp" />
</LinearLayout>
