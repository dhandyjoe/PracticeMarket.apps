<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/shop_item_product_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/pm_space_0_5"
    app:cardBackgroundColor="@color/pm_surface"
    app:cardCornerRadius="@dimen/pm_radius_card"
    app:cardElevation="0dp"
    app:strokeColor="@color/pm_outline"
    app:strokeWidth="@dimen/pm_stroke_hairline">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/shop_item_product_open"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:foreground="?attr/selectableItemBackground"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/shop_img_product_bg"
                android:layout_width="match_parent"
                android:layout_height="@dimen/pm_product_image">

                <ImageView
                    android:id="@+id/shop_img_product"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/pm_space_3"
                android:paddingTop="@dimen/pm_space_2_5">

                <TextView
                    android:id="@+id/shop_txt_product_name"
                    style="@style/Pm.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:textColor="@color/pm_ink"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/shop_txt_product_price"
                    style="@style/Pm.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/pm_space_1"
                    android:textColor="@color/pm_ink"
                    android:textSize="15sp" />

                <LinearLayout
                    android:id="@+id/shop_row_discount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/pm_space_1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/shop_txt_product_old_price"
                        style="@style/Pm.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/shop_txt_product_discount"
                        style="@style/Pm.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/pm_space_1_5"
                        android:textColor="@color/pm_error"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/shop_txt_product_rating"
                    style="@style/Pm.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/pm_space_1" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/pm_space_3">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/shop_btn_add_to_cart"
                style="@style/Widget.PracticeMart.Button.OutlinePrimary"
                android:layout_width="match_parent"
                android:text="@string/cart_add" />
        </FrameLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
