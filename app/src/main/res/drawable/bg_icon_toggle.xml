<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/pm_dark_surface" />
            <corners android:radius="@dimen/pm_radius_md" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/pm_surface" />
            <stroke android:width="@dimen/pm_stroke_hairline" android:color="@color/pm_outline_strong" />
            <corners android:radius="@dimen/pm_radius_md" />
        </shape>
    </item>
</selector>
