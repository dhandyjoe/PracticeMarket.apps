<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/pm_surface_subtle" />
            <stroke android:width="@dimen/pm_stroke_field" android:color="@color/pm_outline_strong" android:dashWidth="6dp" android:dashGap="4dp" />
            <corners android:radius="@dimen/pm_radius_lg" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/pm_primary_surface" />
            <stroke android:width="@dimen/pm_stroke_field" android:color="@color/pm_primary" />
            <corners android:radius="@dimen/pm_radius_lg" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/pm_surface" />
            <stroke android:width="@dimen/pm_stroke_field" android:color="@color/pm_outline" />
            <corners android:radius="@dimen/pm_radius_lg" />
        </shape>
    </item>
</selector>
