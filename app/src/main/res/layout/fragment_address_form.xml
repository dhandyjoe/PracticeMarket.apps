<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pm_background"
    android:orientation="vertical">

    <include
        android:id="@+id/shop_topbar"
        layout="@layout/layout_topbar" />

    <ScrollView
        android:id="@+id/addr_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/pm_space_5">

            <LinearLayout
                android:id="@+id/addr_btn_use_location"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_banner_voucher"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="@dimen/pm_touch_min"
                android:orientation="horizontal"
                android:padding="@dimen/pm_space_3_5">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_location"
                    app:tint="@color/pm_primary_pressed" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/pm_space_3"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Pm.Label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/addr_use_location"
                        android:textColor="@color/pm_primary_pressed"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/addr_txt_location"
                        style="@style/Pm.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/addr_location_need_permission" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/Pm.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/pm_space_4"
                android:text="@string/addr_label" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/addr_group_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/pm_space_1_5"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/addr_chip_home"
                    style="@style/Widget.PracticeMart.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/addr_label_home" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/addr_chip_office"
                    style="@style/Widget.PracticeMart.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/addr_label_office" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/addr_chip_other"
                    style="@style/Widget.PracticeMart.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/addr_label_other" />
            </com.google.android.material.chip.ChipGroup>

            <TextView
                style="@style/Pm.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/pm_space_3_5"
                android:text="@string/addr_recipient" />

            <EditText
                android:id="@+id/addr_input_name"
                style="@style/Pm.Field"
                android:autofillHints="name"
                android:inputType="textPersonName|textCapWords" />

            <TextView
                style="@style/Pm.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/pm_space_3_5"
                android:text="@string/addr_phone" />

            <EditText
                android:id="@+id/addr_input_phone"
                style="@style/Pm.Field"
                android:autofillHints="phone"
                android:inputType="phone" />

            <TextView
                style="@style/Pm.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/pm_space_3_5"
                android:text="@string/addr_province" />

            <Spinner
                android:id="@+id/addr_spn_province"
                style="@style/Pm.Field"
                android:contentDescription="@string/addr_province"
                android:paddingHorizontal="@dimen/pm_space_2" />

            <TextView
                style="@style/Pm.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/pm_space_3_5"
                android:text="@string/addr_city" />

            <Spinner
                android:id="@+id/addr_spn_city"
                style="@style/Pm.Field"
                android:contentDescription="@string/addr_city"
                android:paddingHorizontal="@dimen/pm_space_2" />

            <TextView
                style="@style/Pm.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/pm_space_3_5"
                android:text="@string/addr_street" />

            <EditText
                android:id="@+id/addr_input_street"
                style="@style/Pm.Field"
                android:autofillHints="streetAddress"
                android:gravity="top"
                android:inputType="textPostalAddress|textMultiLine"
                android:maxLines="3"
                android:minHeight="76dp"
                android:paddingVertical="@dimen/pm_space_3"
                android:layout_height="wrap_content" />

            <TextView
                style="@style/Pm.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/pm_space_3_5"
                android:text="@string/addr_postal" />

            <EditText
                android:id="@+id/addr_input_postal"
                style="@style/Pm.Field"
                android:autofillHints="postalCode"
                android:fontFamily="@font/jetbrains_mono"
                android:inputType="number"
                android:maxLength="6" />

            <TextView
                android:id="@+id/addr_error_postal"
                style="@style/Pm.FieldError"
                android:text="@string/addr_postal_invalid"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/pm_space_4"
                android:gravity="center_vertical"
                android:minHeight="@dimen/pm_touch_min"
                android:orientation="horizontal">

                <TextView
                    style="@style/Pm.Body"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/addr_make_primary"
                    android:textColor="@color/pm_ink" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/addr_sw_primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/addr_make_primary" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/addr_bar_save"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/pm_surface"
        android:orientation="vertical"
        android:paddingBottom="@dimen/pm_space_5"
        android:paddingHorizontal="@dimen/pm_space_4"
        android:paddingTop="@dimen/pm_space_3">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/addr_btn_save"
            style="@style/Widget.PracticeMart.Button.Primary"
            android:text="@string/addr_save" />
    </LinearLayout>
</LinearLayout>
