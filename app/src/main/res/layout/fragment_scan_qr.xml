<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pm_black"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/pay_header_scan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="@dimen/pm_header_height"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/pm_space_1">

        <ImageButton
            android:id="@+id/pay_btn_close"
            style="@style/Pm.IconButton"
            android:contentDescription="@string/pay_close"
            android:src="@drawable/ic_close"
            app:tint="@color/pm_white" />

        <TextView
            style="@style/Pm.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/pm_space_2"
            android:layout_weight="1"
            android:accessibilityHeading="true"
            android:text="@string/pay_scan"
            android:textColor="@color/pm_white"
            android:textSize="18sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/pm_space_6">

        <View
            android:id="@+id/pay_frame_viewfinder"
            android:layout_width="240dp"
            android:layout_height="240dp"
            android:background="@drawable/bg_viewfinder"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/pay_txt_scan_hint"
            style="@style/Pm.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/pm_space_6"
            android:gravity="center"
            android:text="@string/pay_scan_hint"
            android:textColor="@color/pm_white" />

        <LinearLayout
            android:id="@+id/pay_banner_denied"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/pm_space_4"
            android:background="@drawable/bg_banner_error"
            android:accessibilityLiveRegion="assertive"
            android:orientation="vertical"
            android:padding="@dimen/pm_space_3_5"
            android:visibility="gone">

            <TextView
                android:id="@+id/pay_txt_banner_title"
                style="@style/Pm.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/pay_camera_denied"
                android:textColor="@color/pm_error_strong"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/pay_txt_banner_body"
                style="@style/Pm.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/pay_camera_denied_body"
                android:textColor="@color/pm_error_strong" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/pay_btn_open_settings"
                style="@style/Widget.PracticeMart.Button.Text"
                android:text="@string/pay_open_settings"
                android:textColor="@color/pm_error_strong" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/pay_bar_gallery"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/pm_space_4">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/pay_btn_gallery"
            style="@style/Widget.PracticeMart.Button.Outline"
            android:layout_width="wrap_content"
            android:minWidth="200dp"
            android:text="@string/pay_gallery"
            android:textColor="@color/pm_white"
            app:icon="@drawable/ic_image"
            app:iconTint="@color/pm_white"
            app:strokeColor="@color/pm_white" />
    </LinearLayout>
</LinearLayout>
