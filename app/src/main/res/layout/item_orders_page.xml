<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/shop_list_orders"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/pm_space_4"
        android:paddingBottom="@dimen/pm_space_4" />

    <LinearLayout
        android:id="@+id/shop_empty_orders"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/pm_space_8"
        android:visibility="gone">

        <TextView
            style="@style/Pm.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ord_empty_title" />

        <TextView
            style="@style/Pm.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/pm_space_1_5"
            android:gravity="center"
            android:text="@string/ord_empty_body" />
    </LinearLayout>
</FrameLayout>
