<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/addr_item_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/pm_space_2_5"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="@dimen/pm_space_4">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/addr_txt_label"
            style="@style/Pm.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/addr_badge_primary"
            style="@style/Pm.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/pm_space_2"
            android:background="@drawable/bg_pill"
            android:paddingHorizontal="@dimen/pm_space_2"
            android:paddingVertical="@dimen/pm_space_0_5"
            android:text="@string/addr_primary"
            android:textColor="@color/pm_primary_pressed"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/addr_txt_recipient"
        style="@style/Pm.Label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/pm_space_1_5"
        android:textColor="@color/pm_ink" />

    <TextView
        android:id="@+id/addr_txt_full"
        style="@style/Pm.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/pm_space_2"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/addr_btn_edit"
            style="@style/Widget.PracticeMart.Button.Text"
            android:text="@string/addr_edit" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/addr_btn_delete"
            style="@style/Widget.PracticeMart.Button.Text"
            android:text="@string/addr_delete"
            android:textColor="@color/pm_error" />
    </LinearLayout>
</LinearLayout>
